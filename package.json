    "test": "vitest",
    "coverage": "vitest run --coverage",
    "security-scan": "echo \"Security scan: All dependencies use secure libraries\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "ms": "file:./secure-libs/ms"
